# STENELLA environment configuration
# These variables are read by the stenella binary when running locally or via CI.
# Copy this file to .env and adjust values for your deployment.

# Listen address (host:port)
STENELLA_ADDR=:8085

# Data root directory (contains apps/, data/pod/, data/secrets/)
STENELLA_ROOT=./data

# Base URL of the pod service (default 127.0.0.1:8081)
# Overridden by POD_URL env var; legacy STELLENA_POD_URL also accepted
POD_URL=http://127.0.0.1:8081

# Base URL of the song service (default 127.0.0.1:8082)
# Overridden by SONG_URL env var
SONG_URL=http://127.0.0.1:8082

# Base URL of the shepherd service (default 127.0.0.1:8083)
# Overridden by SHEPHERD_URL env var
SHEPHERD_URL=http://127.0.0.1:8083

# Shepherd admin token (sent as X-Shepherd-Admin)
# Required for management routes; fallback to STELLENA_ADMIN (legacy)
SHEPHERD_ADMIN=

# Legacy shepherd admin token (deprecated, use SHEPHERD_ADMIN)
STELLENA_ADMIN=

# Base URL of the atp service (default 127.0.0.1:8080)
# Overridden by ATP_URL env var
ATP_URL=http://127.0.0.1:8080

# Legacy atp URL (deprecated, use ATP_URL)
STELLENA_ATP_URL=

# RSS sources CSV list (alternative to SOURCES env var)
# Comma-separated list of RSS feed URLs
STENELLA_RSS_SOURCES=

# Legacy RSS sources env (deprecated, use STENELLA_RSS_SOURCES)
STELLENA_RSS_SOURCES=

# Enable/disable RSS feed fetching
STENELLA_RSS_ENABLED=true

# Maximum items per source per fetch cycle
STENELLA_FETCH_LIMIT=100

# Log level (debug, info, warning, error)
STENELLA_LOG_LEVEL=info